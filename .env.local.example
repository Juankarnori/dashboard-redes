# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta App (Meta for Developers)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v22.0

# Facebook Login for Business — id de la Configuration (App → Facebook
# Login for Business → Configurations). Reemplaza al parámetro `scope`:
# los permisos se definen dentro de la Configuration, no en la URL.
META_LOGIN_CONFIG_ID=

# TikTok for Developers (Login Kit) — app en Sandbox. Redirect URI a
# registrar ahí: <NEXT_PUBLIC_APP_URL>/api/auth/callback/tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Cifrado de tokens (Meta y TikTok, ver lib/crypto.ts): clave de 32 bytes
# en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
META_TOKEN_ENCRYPTION_KEY=

# URL pública de la app (usada para construir los redirect_uri de Meta y
# TikTok). En local: http://localhost:3000  |  En Vercel: https://tu-dominio.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secreto para autenticar al GitHub Action que llama a /api/sync (Fase 2)
SYNC_CRON_SECRET=

# Claude (Fase 4) — ideas de contenido a partir de los mejores posts históricos
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# WhatsApp Cloud API (Fase 5) — bandeja de lectura/respuesta manual.
# Setup en Meta for Developers → tu App → WhatsApp → API Setup:
#   WHATSAPP_PHONE_NUMBER_ID: "Phone number ID" del número de prueba o
#     del número de negocio verificado.
#   WHATSAPP_BUSINESS_ACCOUNT_ID: "WhatsApp Business Account ID".
#   WHATSAPP_ACCESS_TOKEN: token permanente de un System User con permiso
#     whatsapp_business_messaging (el token temporal de la consola expira
#     en 24h — no sirve para producción).
#   WHATSAPP_WEBHOOK_VERIFY_TOKEN: cualquier string que vos elijas — lo
#     escribís acá Y en Meta → WhatsApp → Configuration → Webhook, al
#     configurar la URL <NEXT_PUBLIC_APP_URL>/api/webhooks/whatsapp.
# Sin estas variables, /whatsapp muestra un aviso y no rompe el resto del
# dashboard.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
